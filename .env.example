# Smart Briefing — environment configuration.
#
# Copy this file to .env and fill in EVERY value marked CHANGE_ME below.
# Docker Compose will refuse to start if any required value is missing.
# .env is gitignored and must NEVER be committed.

# ─── OpenSearch ────────────────────────────────────────────────────────────
# URL used by the HOST-SIDE scripts (apply-templates, seed-config).
# n8n itself does NOT read this — it talks to opensearch over the docker
# network using the internal hostname (hardcoded in docker-compose.yml).
# Leave as localhost if you run the stack with the included docker-compose.
OPENSEARCH_URL=https://localhost:9200

# OpenSearch admin password. CHANGE_ME — must be strong:
#   - at least 8 characters
#   - upper + lower case + digit + special char
#   - e.g. MyOpenS3arch!Pass2026
# OpenSearch 2.12+ rejects weak passwords and won't start.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME-strong-password-required

# ─── Postgres (n8n storage backend) ────────────────────────────────────────
# Password for the Postgres database n8n uses to store workflows, executions,
# and credentials. Only used inside the docker network — Postgres is not
# exposed to the host. CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME-strong-password-required

# ─── n8n ───────────────────────────────────────────────────────────────────
# Encryption key for n8n credentials at rest. CHANGE_ME.
# Generate with:
#   Linux/macOS:        openssl rand -hex 32
#   Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# Set BEFORE first launch — n8n auto-generates one if absent, which means
# credentials become unreadable on every restart.
N8N_ENCRYPTION_KEY=CHANGE_ME-64-hex-chars-required

# ─── Email delivery ────────────────────────────────────────────────────────
# The "from" address on the briefing email. CHANGE_ME — must be deliverable
# through your SMTP provider (the address must be authorised to send).
BRIEFING_FROM_EMAIL=CHANGE_ME@example.com

# Primary recipient — where the daily briefing lands. CHANGE_ME.
BRIEFING_TO_EMAIL=CHANGE_ME@example.com

# Optional comma-separated BCC list. Leave blank for none.
BRIEFING_BCC_EMAIL=

# ─── Timezone ──────────────────────────────────────────────────────────────
# Timezone for n8n scheduled triggers. Use a tz database name.
# Examples: Europe/Amsterdam, America/New_York, Asia/Tokyo, UTC
TZ=UTC
