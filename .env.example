# Smart Briefing — environment configuration
# Copy this file to .env and fill in the values for your environment.
# .env should NOT be committed — it's in .gitignore.

# ─── OpenSearch ────────────────────────────────────────────────────────────
# URL of your OpenSearch cluster. If you're using the included docker-compose,
# the default service name works as-is.
OPENSEARCH_URL=https://opensearch:9200

# OpenSearch admin password. Used by the included docker-compose for the
# bootstrap admin user. The n8n workflow does NOT read this directly — it
# uses an n8n HTTP Basic Auth credential you configure in the n8n UI.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=changeme-strong-password-here

# ─── Email delivery ────────────────────────────────────────────────────────
# The "from" address on the briefing email. Must be deliverable through
# your SMTP provider (i.e. the address must be authorised to send).
BRIEFING_FROM_EMAIL=briefing@example.com

# Primary recipient — where the daily briefing lands.
BRIEFING_TO_EMAIL=you@example.com

# Optional comma-separated BCC list. Leave blank for none.
BRIEFING_BCC_EMAIL=

# ─── n8n ───────────────────────────────────────────────────────────────────
# Encryption key for n8n credentials at rest. Generate with:
#   openssl rand -hex 32
# Set this BEFORE first launch or n8n will generate one (which means it'll
# regenerate on every restart and credentials will become unreadable).
N8N_ENCRYPTION_KEY=

# Timezone for scheduled triggers. Use a tz database name.
TZ=Europe/Amsterdam
